<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 通知の常駐コントロール用 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 比較用に TYPE_APPLICATION_OVERLAY を試す場合のみ必要 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- INTERNET は意図的に宣言しない（NFR-01）。このアプリは一切通信しない。 -->

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_view"
        android:label="BlurProbe"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ProbeService"
            android:exported="true"
            android:label="BlurProbe"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 通知ボタンと adb の両方から叩かれる操作の受け口 -->
        <receiver
            android:name=".CtlReceiver"
            android:exported="true" />

        <!-- クイック設定タイル。通知シェードからワンタップで解除できる。 -->
        <service
            android:name=".VeilTile"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_view"
            android:label="Veil"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
