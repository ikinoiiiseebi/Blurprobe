<?xml version="1.0" encoding="utf-8"?>
<!--
    受け取るイベント:
      typeWindowStateChanged … 前面アプリの追跡、通知シェードの開閉検出
      typeViewScrolled       … 1 枚送りのスクロール（Shorts の一次判定とスワイプ計数）

    canRetrieveWindowContent と flagReportViewIds は、Shorts 画面にしか無い
    ビュー ID を探すために必要。**探すのは ID の有無だけで、テキストは読まないし保存もしない**
    （NFR-01）。ID 判定が壊れても一次判定だけで動くようにしてある。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagIncludeNotImportantViews|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0" />
